# .deploy.env.example — ตัวอย่างค่า environment สำหรับ deploy-lftp.sh
# ❌ ห้าม commit ไฟล์ .deploy.env จริงขึ้น GitHub

FTP_HOST=27.254.41.232
FTP_PORT=2121
FTP_USER=sdak@obec.in
FTP_PASS=YOUR_FTP_PASSWORD_HERE
FTP_PROTOCOL=ftp
FTP_TLS_VERIFY=no
REMOTE_DIR=/
SITE_URL=https://sdak.obec.in
DEPLOY_SECRET=your-webhook-secret
REMOTE_STATE_URL=https://sdak.obec.in/deploy-state.php
BACKUP_URL=https://sdak.obec.in/backup-db.php
MIGRATE_URL=https://sdak.obec.in/migrate.php

# Multi-site note (important)
# - This repo currently has 2 production domains in code: sdak.obec.in and saak.obec.in
# - Databases are separated: sdak -> obecin_sdakks, saak -> obecin_saak
# - Future domains can share the same web root by adding config/sites/{domain}.php and migration URL below

# Second site — migration will also run here on every deploy that includes migrations/
# MIGRATE_URL_2=https://saak.obec.in/migrate.php
# DEPLOY_SECRET_2=your-saak-webhook-secret  # ถ้า secret ต่างกัน, ถ้าเหมือนกันไม่ต้องตั้ง

# Future sites (optional)
# MIGRATE_URL_3=https://another-domain.example/migrate.php
# DEPLOY_SECRET_3=your-secret-for-site-3
# MIGRATE_URL_4=https://another-domain-2.example/migrate.php
# DEPLOY_SECRET_4=your-secret-for-site-4

# Optional flags
# If you want the script to check remote deployed commit state before upload:
# CHECK_REMOTE_STATE=yes
# To skip remote state validation, set to no
# CHECK_REMOTE_STATE=no

# If your remote path is not the FTP root, set REMOTE_DIR to that path (for example /public_html)
# REMOTE_DIR=/public_html
